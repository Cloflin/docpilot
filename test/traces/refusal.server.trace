-> model POST /v1/chat/completions (tool probe, messages: 1, tools: search_docs, fetch_section, expand_section, list_pages, answer)
-> endpoint GET /ai/turn/manifest
turn[0].state: (none) -> retrieving
busy: false -> true
status: none -> searching
conversation: none -> <conv:1>
-> endpoint POST /ai/turn
-> embed POST /v1/embeddings (inputs: 1)
