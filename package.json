{
  "name": "@cloflin/docpilot",
  "version": "1.0.1",
  "type": "module",
  "description": "A grounded Ask AI panel for any page of any website — VitePress, Docusaurus, Vue, React, or a plain script tag. Hybrid search runs in the browser against a static index you build; a calibrated gate refuses before the model is called.",
  "keywords": [
    "ask-ai",
    "ai-search",
    "site-search",
    "ai-chatbot",
    "rag",
    "answer-engine",
    "docs-search",
    "docs-chatbot",
    "hybrid-search",
    "chat-widget",
    "embeddable",
    "vitepress",
    "vitepress-plugin",
    "vite-plugin",
    "docusaurus",
    "docusaurus-plugin",
    "vue",
    "react",
    "citations",
    "grounded",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "cloflin (https://github.com/cloflin)",
  "homepage": "https://docpilot-nine.vercel.app",
  "bugs": {
    "url": "https://github.com/cloflin/docpilot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./types/config.d.ts",
      "default": "./dist/config.js"
    },
    "./sidebar": {
      "types": "./types/sidebar.d.ts",
      "default": "./dist/sidebar.js"
    },
    "./theme": {
      "types": "./types/theme.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./theme-without-styles": {
      "types": "./types/theme.d.ts",
      "default": "./dist/theme/no-styles.js"
    },
    "./theme/components/*.vue": "./dist/theme/components/*.vue",
    "./style.css": "./dist/docpilot.css",
    "./style/core.css": "./dist/docpilot-core.css",
    "./style/vitepress.css": "./dist/docpilot-vitepress.css",
    "./package.json": "./package.json",
    "./host": {
      "types": "./types/host.d.ts",
      "default": "./dist/theme/docpilot/host.js"
    },
    "./highlight": {
      "types": "./types/highlight.d.ts",
      "default": "./dist/theme/docpilot/highlight.js"
    },
    "./shiki": {
      "types": "./types/shiki.d.ts",
      "default": "./dist/theme/docpilot/highlighters/shiki.js"
    },
    "./prism": {
      "types": "./types/prism.d.ts",
      "default": "./dist/theme/docpilot/highlighters/prism.js"
    },
    "./hljs": {
      "types": "./types/hljs.d.ts",
      "default": "./dist/theme/docpilot/highlighters/hljs.js"
    },
    "./mount": {
      "types": "./types/mount.d.ts",
      "default": "./dist/mount.js"
    },
    "./web": {
      "types": "./types/web.d.ts",
      "default": "./dist/docpilot.web.mjs"
    },
    "./web.css": "./dist/docpilot.web.css",
    "./style/docusaurus.css": "./dist/docpilot-docusaurus.css",
    "./vue": {
      "types": "./types/vue.d.ts",
      "default": "./dist/adapters/vue.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./dist/adapters/react.js"
    },
    "./docusaurus": {
      "types": "./types/docusaurus.d.ts",
      "default": "./dist/adapters/docusaurus/index.js"
    },
    "./docusaurus/client": {
      "types": "./types/docusaurus-client.d.ts",
      "default": "./dist/adapters/docusaurus/client.js"
    }
  },
  "sideEffects": [
    "*.css",
    "*.scss",
    "./dist/theme/index.js",
    "./dist/web.js"
  ],
  "bin": {
    "docpilot": "bin/docpilot.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "bin/",
    "dist/",
    "skills/",
    "src/",
    "types/"
  ],
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify && npm run build && node scripts/check-publish.js",
    "build": "node bin/build-css.js && node bin/build-js.js && node bin/build-web.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:dist": "npm run build:js && tsc -p tsconfig.conformance.json",
    "check": "bash scripts/check-docpilot.sh",
    "verify": "npm run check && npm run build:js && npm run typecheck && tsc -p tsconfig.conformance.json && npm test",
    "docs:index": "npm run build:js && node bin/docpilot.js index",
    "docs:dev": "npm run build && vitepress dev docs",
    "docs:build": "npm run build && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:css": "node bin/build-css.js",
    "build:js": "node bin/build-js.js",
    "build:web": "node bin/build-web.js"
  },
  "dependencies": {
    "markdown-it": "^15.0.0",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@voidzero-dev/vitepress-theme": "^5.0.5",
    "happy-dom": "^20.11.2",
    "highlight.js": "^11.11.1",
    "linkedom": "^0.18.13",
    "prismjs": "^1.30.0",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitepress": "^2.0.0-alpha.19",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloflin/docpilot.git"
  },
  "types": "./types/index.d.ts"
}
